.model mul

.inputs a1 a0 b1 b0
.outputs y3 y2 y1 y0

# y0 = a0 & b0
.names a0 b0 y0
11 1

# p1 = a1 & b0
.names a1 b0 p1
11 1

# p2 = a0 & b1
.names a0 b1 p2
11 1

# y1 = p1 XOR p2
.names p1 p2 y1
01 1
10 1

# c1 = p1 & p2
.names p1 p2 c1
11 1

# p3 = a1 & b1
.names a1 b1 p3
11 1

# y2 = p3 XOR c1
.names p3 c1 y2
01 1
10 1

# y3 = p3 & c1
.names p3 c1 y3
11 1

.end